DROP DATABASE IF EXISTS rpg_salamancas;
CREATE DATABASE rpg_salamancas;
USE rpg_salamancas;

CREATE TABLE gangue (
    id_gangue INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    bonus_ataque INT NOT NULL,
    dinheiro_inicial DECIMAL(10, 2) NOT NULL
);

CREATE TABLE territorio (
    id_territorio INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    nivel_dificuldade INT NOT NULL,
    recompensa_dinheiro DECIMAL(10, 2) NOT NULL,
    gangue_dominante_id INT,
    FOREIGN KEY (gangue_dominante_id) REFERENCES gangue(id_gangue)
);

CREATE TABLE inimigo (
    id INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    vida_atual INT NOT NULL,
    vida_maxima INT NOT NULL,
    dano INT NOT NULL,
    id_territorio INT,
    FOREIGN KEY (id_territorio) REFERENCES territorio(id_territorio)
);

CREATE TABLE item (
    id_item INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    tipo VARCHAR(50) NOT NULL,
    valor_efeito INT NOT NULL,
    duracao_turnos INT NOT NULL
);

CREATE TABLE jogador (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    vida_atual INT NOT NULL,
    vida_maxima INT NOT NULL,
    dinheiro DECIMAL(10, 2) NOT NULL,
    nivel_respeito INT NOT NULL,
    turnos_dobro_dano INT NOT NULL DEFAULT 0,
    gangue_id INT,
    FOREIGN KEY (gangue_id) REFERENCES gangue(id_gangue)
);

CREATE TABLE inventario_jogador (
    id INT AUTO_INCREMENT PRIMARY KEY,
    jogador_id INT NOT NULL,
    item_id INT NOT NULL,
    FOREIGN KEY (jogador_id) REFERENCES jogador(id),
    FOREIGN KEY (item_id) REFERENCES item(id_item)
);

